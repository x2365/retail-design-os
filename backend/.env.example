# Copy to .env and adjust. SQLite is the zero-setup default for local dev.
ENVIRONMENT=development

# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://retail:retail@db:5432/retaildesign
DATABASE_URL=sqlite:///./retaildesign.db

# Comma-separated allowed browser origins ("*" for dev only)
CORS_ORIGINS=*

# Connection pool (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Seed demo data on first startup
SEED_ON_STARTUP=true

# Uploads: local disk by default (fine for dev). In production, on a host
# with no persistent disk (e.g. Render free tier), set all four R2_* below —
# uploads then go to Cloudflare R2 instead of the ephemeral local filesystem.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- External integrations ---
# POST /api/internal/1c/payment-status — pushes payment_status from 1С,
# X-Service-Token header. Empty = endpoint disabled (403). No real 1С is
# connected here; this is the webhook contract it would call.
ONEC_SERVICE_TOKEN=

# --- Reminders / notifications ---
REMINDERS_SERVICE_TOKEN=
# Email (channel on when host+from set):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Telegram (channel on when token set; user must link chat_id):
TELEGRAM_BOT_TOKEN=
