# Copy to .env and adjust. SQLite is the zero-setup default for local dev.
ENVIRONMENT=development

# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://retail:retail@db:5432/retaildesign
DATABASE_URL=sqlite:///./retaildesign.db

# Comma-separated allowed browser origins ("*" for dev only)
CORS_ORIGINS=*

# Connection pool (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Seed demo data on first startup
SEED_ON_STARTUP=true

# Uploads (mount a volume here in production)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# --- Reminders / notifications ---
REMINDERS_SERVICE_TOKEN=
# Email (channel on when host+from set):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Telegram (channel on when token set; user must link chat_id):
TELEGRAM_BOT_TOKEN=
